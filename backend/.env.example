# ==============================================================================
# MySDE Backend Environment Configuration Example
# Copy this file to .env for local development:
#   Copy-Item .env.example .env
#
# DO NOT COMMIT REAL SECRETS OR PRODUCTION VALUES TO VERSION CONTROL.
# ==============================================================================

# Application Settings
APP_NAME=MySDE Backend
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Security & Sessions
# In production, generate a secure random string (e.g. `openssl rand -hex 32`)
SECRET_KEY=development-insecure-secret-key-replace-in-production-min32chars
SESSION_MAX_AGE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Email Service (development adapter logs links to console/memory; never sends real emails)
EMAIL_PROVIDER=development
EMAIL_FROM=noreply@mysde.local
# SMTP Settings (optional, only when EMAIL_PROVIDER=smtp)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Database Connection (PostgreSQL)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mysde_dev

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# GitHub App Integration
# Configure these when setting up a live GitHub App integration:
# GITHUB_APP_ID=123456
# GITHUB_APP_SLUG=mysde-ai-engineer
# GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxx
# GITHUB_APP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
# GITHUB_WEBHOOK_SECRET=your_webhook_hmac_secret_here
# GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/integrations/github/callback

# Code RAG & Embedding Provider Settings
# EMBEDDING_PROVIDER=fake    # Options: fake (local offline testing), openai (OpenAI/compatible API)
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# CODE_RAG_MAX_FILE_SIZE_BYTES=524288
# CODE_RAG_MAX_FILES_PER_REPO=1000

# Planning Agent Settings (Phase 6)
# LLM_PROVIDER=mock          # Options: mock, groq, openai, anthropic, gemini
# LLM_MODEL=llama-3.3-70b-versatile  # Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant; OpenAI: gpt-4o-mini
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PLANNING_TEMPERATURE=0.2
# PLANNING_MAX_OUTPUT_TOKENS=4096
# PLANNING_MAX_RETRIES=2

# Isolated Sandbox & Execution Settings (Phase 7)
# SANDBOX_PROVIDER=docker    # Options: docker (requires Docker daemon), mock (safe test simulation)
# SANDBOX_DOCKER_IMAGE=python:3.10-slim
# SANDBOX_TIMEOUT_SECONDS=60
# SANDBOX_MEMORY_LIMIT=1024m
# SANDBOX_CPU_LIMIT=1.0
# SANDBOX_MAX_OUTPUT_BYTES=20480
# SANDBOX_MAX_PATCH_BYTES=512000
# SANDBOX_MAX_PATCH_FILES=20

# SaaS Billing, Subscriptions & Metering (Phase 11)
BILLING_PROVIDER=mock       # Options: mock (offline sandbox testing), razorpay (Razorpay Gateway)
BILLING_ENFORCEMENT_ENABLED=true
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here



